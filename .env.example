DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=multi_vendor_ecommerce

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=

# Base URL of the site — used to build absolute links (e.g. the password
# reset link sent by email). IMPORTANT: in production set this to your real
# public URL (e.g. https://yourdomain.com) with no trailing slash, otherwise
# reset emails will contain a localhost link.
APP_URL=http://localhost/LocalKart

# SMTP — used for the password reset email. Any provider works; example
# shows Gmail (use an App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@localkart.test
SMTP_FROM_NAME=LocalKart

# Where messages from the Contact Us form are delivered (defaults to SMTP_USERNAME).
CONTACT_EMAIL=

# Razorpay — from your Razorpay Dashboard > Settings > API Keys.
# RAZORPAY_KEY_ID is safe to expose to the browser (checkout.php prints it
# for Checkout.js). RAZORPAY_KEY_SECRET must stay server-side only — never
# commit it, never put it in any file that gets sent to the browser.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
